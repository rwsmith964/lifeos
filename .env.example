# LifeOS environment variables.
#
# Section 12.9: every external integration is behind an interface with a
# working stub. `pnpm dev` must run with ZERO of these set. Fill in only the
# ones you actually have keys for — everything else degrades gracefully.

# --- Supabase (required for auth + persistence; app runs against local
# Supabase started via `supabase start` during development) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI suggestions, briefs, weekend narration). Without this,
# lib/ai/client.ts falls back to templated, non-AI output. ---
ANTHROPIC_API_KEY=

# --- Resend (email delivery). Without this, lib/notifications email
# adapter logs to console instead of sending. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=lifeos@example.com

# --- Travel time (Section 8.5). Without either, lib/external/travel.ts
# falls back to haversine distance x1.4 road factor / 45mph. ---
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Cron protection: Vercel Cron requests this as a bearer token so the
# brief-generation route can't be triggered by anyone else. ---
CRON_SECRET=

# --- CalDAV credential encryption (Module 4, scheduling_v2, D-120). A
# 32-byte key, base64-encoded (e.g. `openssl rand -base64 32`). Without this,
# lib/security/encryption.ts throws EncryptionKeyNotConfiguredError rather
# than storing a CalDAV app password in plaintext -- CalDAV account
# connections stay unavailable (existing ICS one-way feed import still
# works) until this is set. ---
CALDAV_ENCRYPTION_KEY=

# --- Google Calendar OAuth (Module 4, scheduling_v2 two-way sync). Not yet
# implemented -- see QUEUE-015 in QUESTIONS.md. Apple iCloud and Outlook
# CalDAV two-way sync work without these. ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
